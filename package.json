{
  "name": "floridanomics-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:refresh": "tsx scripts/refresh-data.ts",
    "data:regions": "tsx scripts/refresh-regional-data.ts",
    "data:calendar": "tsx scripts/refresh-release-calendar.ts",
    "data:review": "tsx scripts/check-data-review.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:wser": "tsx scripts/wser-check.ts",
    "data:legiscan": "tsx scripts/legiscan-pull.ts",
    "memo:generate": "tsx scripts/generate-memo.ts",
    "dev:dashboard": "npm run data:refresh && npm run dev",
    "dev": "vite",
    "build": "tsx scripts/check-public-artifacts.ts public && tsc -b && vite build && tsx --tsconfig tsconfig.scripts.json scripts/prerender-regions.tsx && tsx scripts/check-regional-build.ts && tsx scripts/check-public-artifacts.ts dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "security:audit": "npm audit --audit-level=moderate",
    "security:prod": "npm audit --omit=dev --audit-level=moderate",
    "qa:full": "npm run data:refresh && npm run data:validate && npm run lint && npm run typecheck:scripts && npm run build && npm run test && npm run security:audit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
